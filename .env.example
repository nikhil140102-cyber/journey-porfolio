# Where the contact form POSTs { name, email, message, consent }.
# Works with Formspree (https://formspree.io/f/xxxx), Web3Forms, Getform or your own API route.
NEXT_PUBLIC_FORM_ENDPOINT=

# Optional: plug a real LLM into "Ask Nikhil". Must accept POST { question } and return { answer }.
# Leave empty to use the built-in assistant that answers from lib/content.ts.
NEXT_PUBLIC_ASK_ENDPOINT=
